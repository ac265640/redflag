# Copy this file to .streamlit/secrets.toml and fill in your own provider details.
# Keep secrets.toml private; do not upload it or commit it to Git.

[disclosure_ai]
api_key = "YOUR_API_KEY"
base_url = "https://api.openai.com/v1"
model = "YOUR_PROVIDER_MODEL_ID"

# For an OpenAI-compatible provider, replace base_url and model with the values
# supplied by your provider. A local Ollama-compatible endpoint can use:
# base_url = "http://localhost:11434/v1"
# api_key = ""
# model = "YOUR_LOCAL_MODEL_NAME"
